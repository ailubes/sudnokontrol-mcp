{
  "name": "sudnokontrol-mcp",
  "version": "1.0.0",
  "description": "MCP server for the Ukrainian vessel registry (SudnoKontrol): search vessels by registration number, name or owner; look up full registry records; query aggregate statistics. No API key required.",
  "type": "module",
  "bin": {
    "sudnokontrol-mcp": "./dist/index.js"
  },
  "files": [
    "dist"
  ],
  "mcpServers": {
    "sudnokontrol": {
      "url": "https://api.sk.ukrfish.org/mcp"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "vessel",
    "registry",
    "ukraine",
    "maritime",
    "government-data",
    "open-data",
    "search",
    "ai",
    "agent",
    "claude",
    "cursor"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "express": "^5.1.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  }
}